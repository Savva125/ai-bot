# Use random hex secrets to avoid URL escaping issues in the PostgreSQL URL.
POSTGRES_PASSWORD=replace_with_64_random_hex_characters
ADMIN_API_TOKEN=replace_with_another_64_random_hex_characters
TELEGRAM_BOT_TOKEN=replace_with_BotFather_token
TELEGRAM_ADMIN_IDS=123456789
# DNS A/AAAA record must point to your host. This is an API endpoint, no website.
API_DOMAIN=ai.example.com
# Linux GPU host path. Place a supported GGUF file there as model.gguf.
MODEL_DIRECTORY=/srv/creator-desk/models
MODEL_PARALLEL=1
# Pin an image digest after validating on your GPU.
LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
